local function CreateBillboard(adornee, color, text)
    if not adornee or not adornee.Parent then return end
    pcall(function()
        -- Remove old
        local old = adornee:FindFirstChild("AxiomBB")
        if old then old:Destroy() end

        local bb = Instance.new("BillboardGui")
        bb.Name = "AxiomBB"
        bb.AlwaysOnTop = true
        bb.Size = UDim2.new(0, 160, 0, 45)
        bb.StudsOffset = Vector3.new(0, 3.5, 0)
        bb.MaxDistance = CONFIG.Visual.BillboardDistance
        bb.Adornee = adornee

        local lbl = Instance.new("TextLabel", bb)
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = color or Color3.fromRGB(255, 60, 60)
        lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.Text = text or adornee.Name
        lbl.TextWrapped = true

        bb.Parent = adornee
    end)
end

local function UpdateESP()
    if not CONFIG.Visual.ESP then
        ClearESP()
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        pcall(function()
            if p ~= LocalPlayer and p.Character and RootPart then
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildWhichIsA("Humanoid")
                if root and hum then
                    local dist = math.floor((root.Position - RootPart.Position).Magnitude)
                    local hp = math.floor(hum.Health).."/"..math.floor(hum.MaxHealth)
                    CreateBillboard(root, Color3.fromRGB(255, 80, 80),
                        p.Name.."\n❤ "..hp.."\n📏 "..dist.."m")
                end
            end
        end)
    end
end

local function UpdateChestESP()
    if not CONFIG.Visual.ChestESP then return end
    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name:lower():find("chest") then
                if not obj:FindFirstChild("AxiomBB") and RootPart then
                    local dist = (obj.Position - RootPart.Position).Magnitude
                    if dist <= CONFIG.Visual.BillboardDistance then
                        CreateBillboard(obj, Color3.fromRGB(255, 215, 0), "💰 CHEST\n📏 "..math.floor(dist).."m")
                    end
                end
            end
        end
    end)
end

-- // FARM MODULE
local FarmRunning = false

local function AttackTarget(target)
    pcall(function()
        local root = target:FindFirstChild("HumanoidRootPart")
        if not root or not RootPart then return end

        -- Teleport behind mob
        local offset = (RootPart.Position - root.Position).Unit * 5
        SafeTeleport(root.Position + offset)
        task.wait(0.08)

        -- Use equipped tool
        local tool = Character and Character:FindFirstChildWhichIsA("Tool")
        if tool then
            local handle = tool:FindFirstChild("Handle")
            if handle then
                -- Simulate tool activation
                local args = {
                    [1] = target.HumanoidRootPart and target.HumanoidRootPart.Position or root.Position
                }
                -- Try known remotes
                for _, rem in ipairs(tool:GetDescendants()) do
                    if rem:IsA("RemoteEvent") then
                        pcall(function() rem:FireServer(table.unpack(args)) end)
                    end
                end
            end
        end
    end)
end

local function LootDrops()
    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n = obj.Name:lower()
                if n:find("drop") or n:find("beli") or n:find("fragment") or n:find("item") then
                    if RootPart then
                        local dist = (obj.Position - RootPart.Position).Magnitude
                        if dist < 200 then
                            SafeTeleport(obj.Position)
                            task.wait(0.05)
                        end
                    end
                end
            end
        end
    end)
end

local function FarmLoop()
    if FarmRunning then return end
    FarmRunning = true
    while CONFIG.AutoFarm.Enabled do
        local ok, err = pcall(function()
            -- Safety check
            if not Character or not Character.Parent then
                task.wait(1)
                return
            end
            if Humanoid and Humanoid.Health <= 0 then
                task.wait(2)
                return
            end

            local target = GetClosestMob(CONFIG.AutoFarm.MobName, CONFIG.AutoFarm.FarmRadius)
            if target then
                AttackTarget(target)
                if CONFIG.AutoFarm.AutoLoot then
                    LootDrops()
                end
            end
        end)
        if not ok then
            warn("FarmLoop error: "..tostring(err))
        end
        task.wait(0.15)
    end
    FarmRunning = false
end

-- // AIM ASSIST
local function GetAimTarget()
    local closest, closestDist = nil, CONFIG.Combat.FOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    pcall(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local part = p.Character:FindFirstChild(CONFIG.Combat.AimPart)
                if part then
                    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < closestDist then
                            closest = part
                            closestDist = d
                        end
                    end
                end
            end
        end
    end)
    return closest
end

