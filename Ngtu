-- // SAFE TELEPORT
local function SafeTeleport(pos)
    pcall(function()
        if RootPart then
            RootPart.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
        end
    end)
end

-- // GET CLOSEST MOB (safe)
local function GetClosestMob(name, radius)
    local closest, closestDist = nil, radius or 9999
    local ok, err = pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Name:lower():find(name:lower()) then
                local root = obj:FindFirstChild("HumanoidRootPart")
                local hum = obj:FindFirstChildWhichIsA("Humanoid")
                if root and hum and hum.Health > 0 and RootPart then
                    local d = (root.Position - RootPart.Position).Magnitude
                    if d < closestDist then
                        closest = obj
                        closestDist = d
                    end
                end
            end
        end
    end)
    if not ok then warn("GetClosestMob error: "..tostring(err)) end
    return closest, closestDist
end

