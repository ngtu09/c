-- Toggle builder
local function Toggle(label, cfgTable, key, callback)
    local btn = Instance.new("TextButton", Scroll)
    btn.Size = UDim2.new(1, -14, 0, 38)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 13
    btn.TextColor3 = Color3.fromRGB(220, 220, 255)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)

    local function Refresh()
        btn.BackgroundColor3 = cfgTable[key]
            and Color3.fromRGB(70, 0, 160)
            or Color3.fromRGB(22, 22, 32)
        btn.Text = (cfgTable[key] and "✅  " or "❌  ")..label
    end
    Refresh()

    btn.MouseButton1Click:Connect(function()
        cfgTable[key] = not cfgTable[key]
        Refresh()
        if callback then callback(cfgTable[key]) end
    end)
    return btn
end

-- Slider builder
local function Slider(label, cfgTable, key, min, max)
    local container = Instance.new("Frame", Scroll)
    container.Size = UDim2.new(1, -14, 0, 52)
    container.BackgroundColor3 = Color3.fromRGB(18, 18, 28)
    container.BorderSizePixel = 0
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 7)

    local lbl = Instance.new("TextLabel", container)
    lbl.Size = UDim2.new(1, -10, 0, 22)
    lbl.Position = UDim2.new(0, 8, 0, 2)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(200, 180, 255)
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = label..": "..cfgTable[key]

    local track = Instance.new("Frame", container)
    track.Size = UDim2.new(1, -20, 0, 8)
    track.Position = UDim2.new(0, 10, 0, 34)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    track.BorderSizePixel = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3 = Color3.fromRGB(100, 0, 230)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local function UpdateFill()
        local pct = (cfgTable[key] - min) / (max - min)
        fill.Size = UDim2.new(math.clamp(pct, 0, 1), 0, 1, 0)
        lbl.Text = label..": "..cfgTable[key]
    end
    UpdateFill()

    local dragging = false
    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or
           inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or
           inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or
           inp.UserInputType == Enum.UserInputType.Touch) then
            pcall(function()
                local trackPos = track.AbsolutePosition.X
                local trackSize = track.AbsoluteSize.X
                local mouseX = inp.Position.X
                local pct = math.clamp((mouseX - trackPos) / trackSize, 0, 1)
                cfgTable[key] = math.floor(min + (max - min) * pct)
                UpdateFill()
            end)
        end
    end)

    return container
end

